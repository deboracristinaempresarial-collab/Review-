{% liquid
  assign question_items = shop.metaobjects['$app:question'].values
  assign settings_items = shop.metaobjects['$app:settings'].values
  assign global_settings = settings_items.first
  assign show_qa = true
  if global_settings != blank
    assign show_qa = global_settings.show_qa.value
  endif
%}

{% if show_qa %}
<section class="aruna-qa" aria-label="Perguntas e respostas" data-aruna-qa-root>
  <header class="aruna-qa__header">
    <p class="aruna-reviews__eyebrow">ARUNA REVIEW</p>
    <h2>{{ block.settings.heading | escape }}</h2>
  </header>

  <div class="aruna-question-submit">
    <button type="button" class="aruna-review-submit__toggle" data-aruna-question-toggle aria-expanded="false">Fazer uma pergunta</button>
    <form
      class="aruna-review-submit__form"
      data-aruna-question-form
      data-shop-domain="{{ shop.permanent_domain | escape }}"
      data-product-id="{{ product.id }}"
      data-product-handle="{{ product.handle | escape }}"
      data-product-title="{{ product.title | escape }}"
      hidden
    >
      <div class="aruna-review-submit__grid">
        <label>Seu nome<input name="customer_name" type="text" maxlength="200" autocomplete="name" required></label>
        <label>E-mail <span>(opcional)</span><input name="customer_email" type="email" maxlength="320" autocomplete="email"></label>
      </div>
      <label>Sua pergunta<textarea name="question" rows="4" maxlength="3000" required></textarea></label>
      <div class="aruna-review-submit__actions">
        <button type="submit" class="aruna-review-submit__send">Enviar pergunta</button>
        <span data-aruna-question-status role="status" aria-live="polite"></span>
      </div>
      <small>A pergunta passa por moderação antes de ser publicada com a resposta da loja.</small>
    </form>
  </div>

  {% assign qa_count = 0 %}
  <div class="aruna-qa__list">
    {% for item in question_items reversed %}
      {% if item.product_handle.value == product.handle and item.status.value == 'approved' and item.merchant_answer.value != blank %}
        {% assign qa_count = qa_count | plus: 1 %}
        <article class="aruna-qa__item">
          <div class="aruna-qa__question">
            <strong>Pergunta</strong>
            <p>{{ item.question.value | escape | newline_to_br }}</p>
            <small>{{ item.customer_name.value | default: 'Cliente' | escape }}</small>
          </div>
          <div class="aruna-qa__answer">
            <strong>Resposta da loja</strong>
            <p>{{ item.merchant_answer.value | escape | newline_to_br }}</p>
          </div>
        </article>
      {% endif %}
    {% endfor %}
  </div>

  {% if qa_count == 0 %}
    <div class="aruna-reviews__empty">
      <strong>Ainda não há perguntas respondidas.</strong>
      <span>Faça uma pergunta acima ou aguarde as respostas publicadas pela loja.</span>
    </div>
  {% endif %}
</section>
{% endif %}

{% schema %}
{
  "name": "Aruna Perguntas",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "stylesheet": "aruna-reviews.css",
  "javascript": "aruna-question.js",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Perguntas e respostas" }
  ]
}
{% endschema %}