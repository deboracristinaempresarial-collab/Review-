{% liquid
  assign review_items = shop.metaobjects['$app:review'].values
  assign settings_items = shop.metaobjects['$app:settings'].values
  assign global_settings = settings_items.first
  assign review_count = 0
  assign rating_sum = 0

  assign display_heading = block.settings.heading
  assign accent_color = block.settings.accent_color
  assign star_color = block.settings.star_color
  assign visual_theme = block.settings.visual_theme
  assign reviews_per_page = 20
  assign show_verified = true
  assign show_source = true
  assign show_helpful = true

  if global_settings != blank
    if global_settings.heading.value != blank
      assign display_heading = global_settings.heading.value
    endif
    if global_settings.accent_color.value != blank
      assign accent_color = global_settings.accent_color.value
    endif
    if global_settings.star_color.value != blank
      assign star_color = global_settings.star_color.value
    endif
    if global_settings.visual_theme.value != blank
      assign visual_theme = global_settings.visual_theme.value
    endif
    if global_settings.reviews_per_page.value != blank
      assign reviews_per_page = global_settings.reviews_per_page.value | plus: 0
    endif
    assign show_verified = global_settings.show_verified.value
    assign show_source = global_settings.show_source.value
    assign show_helpful = global_settings.show_helpful.value
  endif

  for review in review_items
    if review.product_handle.value == product.handle and review.status.value == 'approved'
      assign review_count = review_count | plus: 1
      assign current_rating = review.rating.value | default: 0 | plus: 0
      assign rating_sum = rating_sum | plus: current_rating
    endif
  endfor

  if review_count > 0
    assign rating_average = rating_sum | times: 1.0 | divided_by: review_count
  else
    assign rating_average = 0
  endif
%}

<section
  id="aruna-reviews"
  class="aruna-reviews aruna-reviews--{{ visual_theme }}"
  style="--aruna-accent: {{ accent_color }}; --aruna-star: {{ star_color }};"
  data-aruna-reviews-root
>
  <header class="aruna-reviews__header">
    <div>
      <p class="aruna-reviews__eyebrow">ARUNA REVIEW</p>
      <h2>{{ display_heading | escape }}</h2>
    </div>

    <div class="aruna-reviews__summary" aria-label="Resumo das avaliações">
      <strong>{{ rating_average | round: 1 | replace: '.', ',' }}</strong>
      <span class="aruna-stars" aria-label="{{ rating_average | round: 1 }} de 5 estrelas">
        {% assign rounded_average = rating_average | round %}
        {% for star in (1..5) %}{% if star <= rounded_average %}★{% else %}☆{% endif %}{% endfor %}
      </span>
      <small>{{ review_count }} {% if review_count == 1 %}avaliação{% else %}avaliações{% endif %}</small>
    </div>
  </header>

  <div class="aruna-review-submit">
    <button type="button" class="aruna-review-submit__toggle" data-aruna-review-toggle aria-expanded="false">Escrever uma avaliação</button>
    <form
      class="aruna-review-submit__form"
      data-aruna-review-form
      data-shop-domain="{{ shop.permanent_domain | escape }}"
      data-product-id="{{ product.id }}"
      data-product-handle="{{ product.handle | escape }}"
      data-product-title="{{ product.title | escape }}"
      hidden
    >
      <div class="aruna-review-submit__grid">
        <label>Seu nome<input name="customer_name" type="text" maxlength="200" autocomplete="name" required></label>
        <label>E-mail <span>(opcional)</span><input name="customer_email" type="email" maxlength="320" autocomplete="email"></label>
        <label>Nota
          <select name="rating" required>
            <option value="5">5 — Excelente</option>
            <option value="4">4 — Muito bom</option>
            <option value="3">3 — Bom</option>
            <option value="2">2 — Regular</option>
            <option value="1">1 — Ruim</option>
          </select>
        </label>
        <label>Título <span>(opcional)</span><input name="title" type="text" maxlength="300"></label>
      </div>
      <label>Sua avaliação<textarea name="body" rows="5" maxlength="5000" required></textarea></label>
      <label>Fotos e vídeos <span>(opcional · até 4 arquivos de 25 MB)</span><input name="media" type="file" accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,video/quicktime" multiple></label>
      <div class="aruna-review-submit__actions">
        <button type="submit" class="aruna-review-submit__send">Enviar avaliação</button>
        <span data-aruna-review-status role="status" aria-live="polite"></span>
      </div>
      <small>A avaliação passa por moderação antes de aparecer na loja.</small>
    </form>
  </div>

  {% if review_count > 0 %}
    <div class="aruna-reviews__toolbar aruna-reviews__toolbar--info">
      <span>Experiências de clientes</span>
      <span>{{ review_count }} publicadas</span>
    </div>

    <div class="aruna-reviews__list">
      {% assign rendered_reviews = 0 %}
      {% for review in review_items reversed %}
        {% if review.product_handle.value == product.handle and review.status.value == 'approved' and rendered_reviews < reviews_per_page %}
          {% assign rendered_reviews = rendered_reviews | plus: 1 %}
          {% assign rating = review.rating.value | default: 0 | plus: 0 %}
          <article class="aruna-review-card">
            <div class="aruna-review-card__top">
              <div class="aruna-review-card__identity">
                <strong>{{ review.customer_name.value | default: 'Cliente' | escape }}</strong>
                {% if show_verified and review.verified.value == true %}
                  <span class="aruna-review-badge">✓ Compra verificada</span>
                {% endif %}
                {% if review.featured.value == true %}
                  <span class="aruna-review-badge aruna-review-badge--featured">Destaque</span>
                {% endif %}
              </div>
              {% if review.review_date.value != blank %}
                <span class="aruna-review-card__date">{{ review.review_date.value | date: '%d/%m/%Y' }}</span>
              {% endif %}
            </div>

            <div class="aruna-review-card__stars" aria-label="{{ rating }} de 5 estrelas">
              {% for star in (1..5) %}{% if star <= rating %}★{% else %}☆{% endif %}{% endfor %}
            </div>

            {% if review.title.value != blank %}
              <h3>{{ review.title.value | escape }}</h3>
            {% endif %}

            {% if review.body.value != blank %}
              <p class="aruna-review-card__body">{{ review.body.value | escape | newline_to_br }}</p>
            {% endif %}

            {% if review.media_urls.value != blank %}
              <div class="aruna-review-media">
                {% for media_url in review.media_urls.value limit: 8 %}
                  {% assign media_value = media_url | downcase %}
                  {% if media_value contains '.mp4' or media_value contains '.webm' or media_value contains '.mov' %}
                    <video src="{{ media_url | escape }}" controls preload="metadata"></video>
                  {% else %}
                    <img src="{{ media_url | escape }}" alt="Foto enviada na avaliação" loading="lazy" width="120" height="120">
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            {% if review.merchant_reply.value != blank %}
              <div class="aruna-review-reply">
                <strong>Resposta da loja</strong>
                <p>{{ review.merchant_reply.value | escape | newline_to_br }}</p>
              </div>
            {% endif %}

            {% if show_source or show_helpful %}
              <div class="aruna-review-card__footer">
                {% if show_source and review.source.value != blank %}<span>Origem: {{ review.source.value | escape }}</span>{% endif %}
                {% if show_helpful and review.helpful_count.value > 0 %}<span>{{ review.helpful_count.value }} acharam útil</span>{% endif %}
              </div>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>

    {% if review_count > reviews_per_page %}
      <p class="aruna-reviews__more-note">Exibindo {{ reviews_per_page }} de {{ review_count }} avaliações.</p>
    {% endif %}
  {% else %}
    <div class="aruna-reviews__empty">
      <strong>Ainda não há avaliações publicadas.</strong>
      <span>As avaliações aprovadas no Aruna Review aparecem aqui automaticamente.</span>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Aruna Reviews",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "stylesheet": "aruna-reviews.css",
  "javascript": "aruna-submission.js",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título de fallback", "default": "Avaliações de clientes" },
    { "type": "color", "id": "accent_color", "label": "Cor principal de fallback", "default": "#0B4FA3" },
    { "type": "color", "id": "star_color", "label": "Cor das estrelas de fallback", "default": "#F5B301" },
    { "type": "select", "id": "visual_theme", "label": "Tema de fallback", "default": "aruna-premium", "options": [
      {"value":"compat-01","label":"Compatibilidade 01 — Clássico"},
      {"value":"compat-02","label":"Compatibilidade 02 — Moderno"},
      {"value":"compat-03","label":"Compatibilidade 03 — Marketplace"},
      {"value":"compat-04","label":"Compatibilidade 04 — Galeria"},
      {"value":"compat-05","label":"Compatibilidade 05 — Cards"},
      {"value":"compat-06","label":"Compatibilidade 06 — Minimal"},
      {"value":"compat-07","label":"Compatibilidade 07 — Centralizado"},
      {"value":"compat-08","label":"Compatibilidade 08 — Social"},
      {"value":"compat-09","label":"Compatibilidade 09 — Lista"},
      {"value":"compat-10","label":"Compatibilidade 10 — Amplo"},
      {"value":"compat-11","label":"Compatibilidade 11 — Escuro"},
      {"value":"aruna-premium","label":"ARUNA — Premium"},
      {"value":"aruna-compact","label":"ARUNA — Compacto"},
      {"value":"aruna-media","label":"ARUNA — Fotos & Vídeos"},
      {"value":"aruna-lux","label":"ARUNA — Lux"}
    ]}
  ]
}
{% endschema %}