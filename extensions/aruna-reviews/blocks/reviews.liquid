{% liquid
  assign review_items = shop.metaobjects['$app:review'].values
  assign review_count = 0
  assign rating_sum = 0

  for review in review_items
    if review.product_handle.value == product.handle and review.status.value == 'approved'
      assign review_count = review_count | plus: 1
      assign current_rating = review.rating.value | default: 0 | plus: 0
      assign rating_sum = rating_sum | plus: current_rating
    endif
  endfor

  if review_count > 0
    assign rating_average = rating_sum | times: 1.0 | divided_by: review_count
  else
    assign rating_average = 0
  endif
%}

<section
  class="aruna-reviews aruna-reviews--{{ block.settings.visual_theme }}"
  style="--aruna-accent: {{ block.settings.accent_color }}; --aruna-star: {{ block.settings.star_color }};"
>
  <header class="aruna-reviews__header">
    <div>
      <p class="aruna-reviews__eyebrow">ARUNA REVIEW</p>
      <h2>{{ block.settings.heading | escape }}</h2>
    </div>

    <div class="aruna-reviews__summary" aria-label="Resumo das avaliações">
      <strong>{{ rating_average | round: 1 | replace: '.', ',' }}</strong>
      <span class="aruna-stars" aria-label="{{ rating_average | round: 1 }} de 5 estrelas">
        {% assign rounded_average = rating_average | round %}
        {% for star in (1..5) %}{% if star <= rounded_average %}★{% else %}☆{% endif %}{% endfor %}
      </span>
      <small>{{ review_count }} {% if review_count == 1 %}avaliação{% else %}avaliações{% endif %}</small>
    </div>
  </header>

  {% if review_count > 0 %}
    <div class="aruna-reviews__toolbar aruna-reviews__toolbar--info">
      <span>Experiências de clientes</span>
      <span>{{ review_count }} publicadas</span>
    </div>

    <div class="aruna-reviews__list">
      {% for review in review_items reversed %}
        {% if review.product_handle.value == product.handle and review.status.value == 'approved' %}
          {% assign rating = review.rating.value | default: 0 | plus: 0 %}
          <article class="aruna-review-card">
            <div class="aruna-review-card__top">
              <div class="aruna-review-card__identity">
                <strong>{{ review.customer_name.value | default: 'Cliente' | escape }}</strong>
                {% if review.verified.value == true %}
                  <span class="aruna-review-badge">✓ Compra verificada</span>
                {% endif %}
                {% if review.featured.value == true %}
                  <span class="aruna-review-badge aruna-review-badge--featured">Destaque</span>
                {% endif %}
              </div>
              {% if review.review_date.value != blank %}
                <span class="aruna-review-card__date">{{ review.review_date.value | date: '%d/%m/%Y' }}</span>
              {% endif %}
            </div>

            <div class="aruna-review-card__stars" aria-label="{{ rating }} de 5 estrelas">
              {% for star in (1..5) %}{% if star <= rating %}★{% else %}☆{% endif %}{% endfor %}
            </div>

            {% if review.title.value != blank %}
              <h3>{{ review.title.value | escape }}</h3>
            {% endif %}

            {% if review.body.value != blank %}
              <p class="aruna-review-card__body">{{ review.body.value | escape | newline_to_br }}</p>
            {% endif %}

            {% if review.media_urls.value != blank %}
              <div class="aruna-review-media">
                {% for media_url in review.media_urls.value limit: 8 %}
                  {% assign media_value = media_url | downcase %}
                  {% if media_value contains '.mp4' or media_value contains '.webm' or media_value contains '.mov' %}
                    <video src="{{ media_url | escape }}" controls preload="metadata"></video>
                  {% else %}
                    <img src="{{ media_url | escape }}" alt="Foto enviada na avaliação" loading="lazy" width="120" height="120">
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            {% if review.merchant_reply.value != blank %}
              <div class="aruna-review-reply">
                <strong>Resposta da loja</strong>
                <p>{{ review.merchant_reply.value | escape | newline_to_br }}</p>
              </div>
            {% endif %}

            <div class="aruna-review-card__footer">
              {% if review.source.value != blank %}<span>Origem: {{ review.source.value | escape }}</span>{% endif %}
              {% if review.helpful_count.value > 0 %}<span>{{ review.helpful_count.value }} acharam útil</span>{% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  {% else %}
    <div class="aruna-reviews__empty">
      <strong>Ainda não há avaliações publicadas.</strong>
      <span>As avaliações aprovadas no Aruna Review aparecem aqui automaticamente.</span>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Aruna Reviews",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "stylesheet": "aruna-reviews.css",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Avaliações de clientes" },
    { "type": "color", "id": "accent_color", "label": "Cor principal", "default": "#0B4FA3" },
    { "type": "color", "id": "star_color", "label": "Cor das estrelas", "default": "#F5B301" },
    { "type": "select", "id": "visual_theme", "label": "Tema", "default": "aruna-premium", "options": [
      {"value":"compat-01","label":"Compatibilidade 01 — Clássico"},
      {"value":"compat-02","label":"Compatibilidade 02 — Moderno"},
      {"value":"compat-03","label":"Compatibilidade 03 — Marketplace"},
      {"value":"compat-04","label":"Compatibilidade 04 — Galeria"},
      {"value":"compat-05","label":"Compatibilidade 05 — Cards"},
      {"value":"compat-06","label":"Compatibilidade 06 — Minimal"},
      {"value":"compat-07","label":"Compatibilidade 07 — Centralizado"},
      {"value":"compat-08","label":"Compatibilidade 08 — Social"},
      {"value":"compat-09","label":"Compatibilidade 09 — Lista"},
      {"value":"compat-10","label":"Compatibilidade 10 — Amplo"},
      {"value":"compat-11","label":"Compatibilidade 11 — Escuro"},
      {"value":"aruna-premium","label":"ARUNA — Premium"},
      {"value":"aruna-compact","label":"ARUNA — Compacto"},
      {"value":"aruna-media","label":"ARUNA — Fotos & Vídeos"},
      {"value":"aruna-lux","label":"ARUNA — Lux"}
    ]}
  ]
}
{% endschema %}
